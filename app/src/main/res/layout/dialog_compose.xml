<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_brand_badge"/>
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@color/white"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share an unsaid feeling"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your identity stays anonymous"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnComposeClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_anon"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Text area -->
    <EditText
        android:id="@+id/etComposeText"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="What's unsaid in your heart today? Share anonymously with those nearby in Cebu…"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingMultiplier="1.45"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#A8A0BD"
        android:textSize="15sp"/>

    <!-- Error -->
    <TextView
        android:id="@+id/tvComposeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/error_bg"
        android:padding="12dp"
        android:textColor="#991B1B"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvComposeLoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="0/500"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComposePost"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_gradient_button"
            android:paddingHorizontal="22dp"
            android:text="Post"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>
</LinearLayout>
