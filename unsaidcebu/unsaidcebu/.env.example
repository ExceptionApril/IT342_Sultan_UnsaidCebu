# Copy this file to ".env" in the same folder and fill in real values.
# .env is gitignored — never commit it.

# Supabase Postgres (Session Pooler, IPv4)
DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-db-password>

# JWT signing key — must be >= 32 chars (256 bits). Generate a fresh random one.
# Example (PowerShell):  [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
JWT_SECRET=<paste-a-long-random-string-here>
